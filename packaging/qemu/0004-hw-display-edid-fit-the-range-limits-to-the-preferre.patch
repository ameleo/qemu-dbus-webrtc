From cb918a0a0e5459f4ed6b1f1698d4e135de1b2f55 Mon Sep 17 00:00:00 2001
From: Super User <root@pc-mike1.home>
Date: Mon, 16 Nov 2026 14:15:46 +0100
Subject: [PATCH 4/4] hw/display/edid: fit the range limits to the preferred
 mode

The range limits descriptor caps the vertical rate at 125 Hz and the
horizontal rate at 160 kHz, but the preferred mode can be above them:
at the default 75 Hz, 3840x2160 needs 168 kHz (generate_timings() blanks
3.5 % of the lines). A guest that checks its modes against the limits,
as Windows does, then drops the very mode the host asked for.

Raise each limit to the preferred mode's rate when it is higher, using
the +255 offsets of EDID 1.4 (byte 4 of the descriptor, bits 1 and 3)
above 255, up to 510.
---
 hw/display/edid-generate.c | 36 ++++++++++++++++++++++++++++++------
 1 file changed, 30 insertions(+), 6 deletions(-)

diff --git a/hw/display/edid-generate.c b/hw/display/edid-generate.c
index 2cb8196..67828e4 100644
--- a/hw/display/edid-generate.c
+++ b/hw/display/edid-generate.c
@@ -220,17 +220,41 @@ static void edid_desc_text(uint8_t *desc, uint8_t type,
     desc[5 + len] = '\n';
 }
 
-static void edid_desc_ranges(uint8_t *desc)
+/*
+ * A range limit for the range limits descriptor: the value, and whether it
+ * takes the +255 offset of EDID 1.4 (510 at most).
+ */
+static uint8_t edid_range_limit(uint32_t value, bool *offset)
+{
+    value = MIN(value, 255 + 255);
+    *offset = value > 255;
+    return *offset ? value - 255 : value;
+}
+
+static void edid_desc_ranges(uint8_t *desc, const Timings *timings,
+                             uint32_t refresh_rate, uint32_t yres)
 {
+    /* the preferred mode's rates, rounded up: mHz and kHz */
+    uint32_t vfreq = DIV_ROUND_UP(refresh_rate, 1000);
+    uint32_t hfreq = DIV_ROUND_UP((uint64_t)refresh_rate *
+                                  (yres + timings->yblank), 1000000);
+    bool offset;
+
     edid_desc_type(desc, 0xfd);
 
-    /* vertical (50 -> 125 Hz) */
+    /* vertical (50 -> 125 Hz, or the preferred mode's rate) */
     desc[5] =  50;
-    desc[6] = 125;
+    desc[6] = edid_range_limit(MAX(125, vfreq), &offset);
+    if (offset) {
+        desc[4] |= 1 << 1;
+    }
 
-    /* horizontal (30 -> 160 kHz) */
+    /* horizontal (30 -> 160 kHz, or the preferred mode's rate) */
     desc[7] =  30;
-    desc[8] = 160;
+    desc[8] = edid_range_limit(MAX(160, hfreq), &offset);
+    if (offset) {
+        desc[4] |= 1 << 3;
+    }
 
     /* max dot clock (2550 MHz) */
     desc[9] = 2550 / 10;
@@ -513,7 +537,7 @@ void qemu_edid_generate(uint8_t *edid, size_t size,
      * so dta descriptor offsets don't move any more.
      */
 
-    edid_desc_ranges(desc);
+    edid_desc_ranges(desc, &timings, refresh_rate, info->prefy);
     desc = edid_desc_next(edid, dta, desc);
 
     if (desc && info->name) {
-- 
